@page "/inventory"
@rendermode InteractiveServer
@attribute [StreamRendering]

@inject IDbContextFactory<InventoryDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Inventory</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="mb-1">Add Inventory</h1>
        <p class="text-body-secondary mb-0">Create new stock entries and review the seeded sample data.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <strong>Add Item</strong>
            </div>
            <div class="card-body">
                <EditForm FormName="InventoryCreateForm" Model="newItem" OnValidSubmit="CreateItemAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <InventoryFields Model="newItem" />

                    <button class="btn btn-primary" type="submit" disabled="@isBusy">Save item</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly InventoryItem newItem = new() { LastUpdated = DateTime.UtcNow };
    private bool isBusy;

    private async Task CreateItemAsync()
    {
        isBusy = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            newItem.LastUpdated = DateTime.UtcNow;
            db.InventoryItems.Add(newItem);
            await db.SaveChangesAsync();

            NavigationManager.NavigateTo("/");
        }
        finally
        {
            isBusy = false;
        }
    }
}